{
  "name": "orp-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:rules": "firebase emulators:exec --only firestore --project demo-orp \"vitest run tests\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-orp",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "lint": "eslint src scripts e2e tests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
